# Files and folders to ignore during Vercel deployment

# Development files
.env.local
.env.development
.env.test

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Cache directories
.cache/
.next/
.nuxt/

# Test files
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
coverage/

# Documentation (optional - remove if you want docs deployed)
docs/
*.md
!README.md

# Local development scripts
scripts/dev/
scripts/local/

# Backup files
*.bak
*.backup

# Temporary files
tmp/
temp/

# Local configuration
.local/
local.config.*

# Development dependencies (Vercel handles this automatically)
# node_modules/ (commented out - Vercel needs to install dependencies)

# Source maps (optional - for smaller builds)
# *.map

# ESLint and Prettier cache
.eslintcache
.stylelintcache

# Local environment overrides
.env.override

# Git
.git/
.gitignore

# CI/CD (if not needed in production)
.github/workflows/
.gitlab-ci.yml
.travis.yml

# Local server files
server.js