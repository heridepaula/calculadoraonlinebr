# Environment Configuration
NODE_ENV=production

# Application Settings
APP_NAME=Calculadora Online BR
APP_URL=https://calculadoraonline.com.br
APP_VERSION=1.0.0

# SEO and Analytics (Optional)
# Google Analytics 4 - Ativo apenas em produção
VITE_GA_ID=G-XXXXXXXXXX

# Cloudflare Web Analytics - Ativo apenas em produção
# Token disponível no dashboard do Cloudflare
VITE_CLOUDFLARE_TOKEN=17de6aebxxxxxxxxxxed4fb3aa

# GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
# GOOGLE_SITE_VERIFICATION=your_verification_code

# Social Media (Optional)
# TWITTER_HANDLE=@calculadorabr
# FACEBOOK_PAGE=calculadoraonlinebr

# Performance and Monitoring (Optional)
# SENTRY_DSN=your_sentry_dsn_here

# Vercel Analytics & Speed Insights (Automatically provided in production)
# VERCEL_ANALYTICS_ID=your_vercel_analytics_id
# VERCEL_SPEED_INSIGHTS_ID=your_speed_insights_id
# These are automatically injected by Vercel in production

# Security Headers (Optional - if you want to override defaults)
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'

# Database (If you add one later)
# DATABASE_URL=your_database_url_here
# DATABASE_CONNECTION_LIMIT=10

# Email Service (If you add contact forms later)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Feature Flags (Optional)
# ENABLE_PWA=false
# ENABLE_OFFLINE_MODE=false
# MAINTENANCE_MODE=false

# API Keys (If you integrate with external services)
# EXCHANGE_RATES_API_KEY=your_api_key
# WEATHER_API_KEY=your_api_key

# Cache Settings (Optional)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600