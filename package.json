{
  "name": "calculadora-online-br",
  "version": "1.0.0",
  "description": "Calculadoras online gratuitas - IMC, Porcentagem, Juros",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production remix vite:build",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "dev": "remix vite:dev",
    "start": "remix-serve ./build/server/index.js",
    "lint": "eslint --ignore-path .gitignore .",
    "typecheck": "tsc",
    "clean": "rm -rf build .cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "og:generate": "node scripts/generate-og-image.mjs",
    "indexnow:config": "node scripts/indexnow-submit.js --config",
    "indexnow:main": "node scripts/indexnow-submit.js --all-main-pages",
    "indexnow:submit": "node scripts/indexnow-submit.js"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.12",
    "@remix-run/node": "2.16.7",
    "@remix-run/react": "2.16.7",
    "@remix-run/serve": "2.16.7",
    "@vercel/analytics": "^1.5.0",
    "@vercel/remix": "2.16.7",
    "@vercel/speed-insights": "^1.2.0",
    "chart.js": "^4.5.0",
    "clsx": "2.1.1",
    "compression": "^1.8.1",
    "isbot": "4.1.0",
    "node-fetch": "^3.3.2",
    "react": "18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "2.16.7",
    "@types/react": "18.2.20",
    "@types/react-dom": "18.2.7",
    "@typescript-eslint/eslint-plugin": "6.7.4",
    "@typescript-eslint/parser": "6.7.4",
    "autoprefixer": "10.4.19",
    "cross-env": "^10.0.0",
    "cssnano": "^7.1.0",
    "eslint": "8.38.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "8.4.38",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.4",
    "terser": "5.43.1",
    "typescript": "5.1.6",
    "vite": "6.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-tsconfig-paths": "4.3.2"
  },
  "keywords": [
    "calculadora",
    "imc",
    "juros compostos",
    "porcentagem",
    "financas",
    "saude",
    "matematica",
    "remix",
    "react",
    "typescript"
  ],
  "homepage": "https://calculadoraonline.com.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/heridepaula/calculadoraonlinebrv2.git"
  },
  "author": {
    "name": "CalculadoraOnlineBR",
    "url": "https://calculadoraonline.com.br"
  },
  "license": "MIT"
}
